# Codex Dokploy Production Environment Configuration
# Copy this file to ./data/.env before deployment
# Generate secure random strings for production use!

###########################################
######## CORE CONFIGURATION ###############
###########################################
SERVER_PORT=3030
STORAGE_DIR="/app/server/storage"
UID=1000
GID=1000

###########################################
######## SECURITY KEYS ####################
###########################################
# IMPORTANT: Generate secure random strings for production!
# You can use: openssl rand -hex 32

# JWT Secret - At least 12 characters (recommended: 32+ chars)
JWT_SECRET="CHANGE_THIS_TO_RANDOM_32_CHAR_STRING_FOR_PRODUCTION"

# JWT Token Expiry
JWT_EXPIRY="30d"

# Signature Key - At least 32 characters
SIG_KEY="CHANGE_THIS_TO_RANDOM_32_CHAR_PASSPHRASE_FOR_PRODUCTION"

# Signature Salt - At least 32 characters  
SIG_SALT="CHANGE_THIS_TO_RANDOM_32_CHAR_SALT_FOR_PRODUCTION"

# Optional: Set this to protect your instance with a password
# AUTH_TOKEN="your-secure-access-password"

###########################################
######## LLM PROVIDER CONFIGURATION #######
###########################################
# Default: Ollama (local) - Change to your preferred provider

# Option 1: Ollama (Local LLM)
LLM_PROVIDER='ollama'
OLLAMA_BASE_PATH='http://host.docker.internal:11434'
OLLAMA_MODEL_PREF='llama3.2'
OLLAMA_MODEL_TOKEN_LIMIT=8192

# Option 2: OpenAI
# LLM_PROVIDER='openai'
# OPEN_AI_KEY='sk-...'
# OPEN_MODEL_PREF='gpt-5-nano'

# Option 3: Anthropic Claude
# LLM_PROVIDER='anthropic'
# ANTHROPIC_API_KEY='sk-ant-...'
# ANTHROPIC_MODEL_PREF='claude-3-5-sonnet-20241022'

# Option 4: Google Gemini
# LLM_PROVIDER='gemini'
# GEMINI_API_KEY='...'
# GEMINI_LLM_MODEL_PREF='gemini-2.0-flash-lite'

# Option 5: Azure OpenAI
# LLM_PROVIDER='azure'
# AZURE_OPENAI_ENDPOINT='https://your-resource.openai.azure.com/'
# AZURE_OPENAI_KEY='...'
# OPEN_MODEL_PREF='your-deployment-name'

###########################################
######## EMBEDDING CONFIGURATION ##########
###########################################
# Default: Native (runs locally, no API needed)
EMBEDDING_ENGINE='native'
EMBEDDING_MODEL_PREF='Xenova/all-MiniLM-L6-v2'

# Alternative: Use your LLM provider's embeddings
# EMBEDDING_ENGINE='openai'
# OPEN_AI_KEY='sk-...'
# EMBEDDING_MODEL_PREF='text-embedding-3-small'

###########################################
######## VECTOR DATABASE ##################
###########################################
# Default: LanceDB (local, no external dependencies)
VECTOR_DB="lancedb"

# Alternative Options:

# Pinecone (Cloud)
# VECTOR_DB="pinecone"
# PINECONE_API_KEY="..."
# PINECONE_INDEX="codex"

# Qdrant (Self-hosted or Cloud)
# VECTOR_DB="qdrant"
# QDRANT_ENDPOINT="http://localhost:6333"
# QDRANT_API_KEY="..."

# ChromaDB (Self-hosted)
# VECTOR_DB="chroma"
# CHROMA_ENDPOINT='http://localhost:8000'
# CHROMA_API_HEADER="X-Api-Key"
# CHROMA_API_KEY="..."

# PostgreSQL with pgvector
# VECTOR_DB="pgvector"
# PGVECTOR_CONNECTION_STRING="postgresql://user:pass@localhost:5432/codex"

###########################################
######## AUDIO/SPEECH CONFIGURATION #######
###########################################
# Whisper for speech-to-text
WHISPER_PROVIDER="local"

# Text-to-speech
TTS_PROVIDER="native"

# Alternative: OpenAI TTS
# TTS_PROVIDER="openai"
# TTS_OPEN_AI_KEY="sk-..."
# TTS_OPEN_AI_VOICE_MODEL="nova"

###########################################
######## AGENT CONFIGURATION ##############
###########################################
# Optional: Configure search engines for agents

# Google Search
# AGENT_GSE_KEY="..."
# AGENT_GSE_CTX="..."

# Serper.dev
# AGENT_SERPER_DEV_KEY="..."

# Tavily
# AGENT_TAVILY_API_KEY="..."

###########################################
######## PASSWORD POLICY ##################
###########################################
# Optional: Enforce password requirements
PASSWORDMINCHAR=8
PASSWORDMAXCHAR=250
PASSWORDLOWERCASE=1
PASSWORDUPPERCASE=1
PASSWORDNUMERIC=1
PASSWORDSYMBOL=1
PASSWORDREQUIREMENTS=4

###########################################
######## ADVANCED CONFIGURATION ###########
###########################################
# Disable telemetry for privacy
DISABLE_TELEMETRY=true

# Allow local IP scraping in collector
# COLLECTOR_ALLOW_ANY_IP="true"

# Target languages for OCR (comma-separated)
# TARGET_OCR_LANG=eng,spa,fra,deu

# Disable chat history viewing (privacy mode)
# DISABLE_VIEW_CHAT_HISTORY=1

# Enable SSO passthrough
# SIMPLE_SSO_ENABLED=1
# SIMPLE_SSO_NO_LOGIN=1